# ============================================================
# Grond OSINT Platform — Environment Variables
# Copy to .env and fill in your values. Never commit .env.
# ============================================================

# ── OSINT Tools ──────────────────────────────────────────────
SHODAN_API_KEY=
TAVILY_API_KEY=
# X / Twitter API v2 — create at https://developer.twitter.com/en/portal/dashboard
# Free tier: /tweets/search/recent (last 7 days, 1 app / 15-min window)
# Academic/Pro tier: /tweets/search/all (full archive, back to 2006)
TWITTER_BEARER_TOKEN=
TWITTER_MAX_RESULTS=100

# SEC EDGAR (Bellingcat edgar-tool): no API key — follow SEC access/fair-use guidance
# https://www.sec.gov/edgar/sec-data-documentation

# theHarvester (optional subprocess) — https://github.com/laramies/theHarvester/wiki
# THEHARVESTER_BIN=          # leave empty for PATH `theHarvester` or `python -m theHarvester`
# THEHARVESTER_TIMEOUT_SECONDS=600
# Upstream API keys: configure ~/.theHarvester/api-keys.yaml (not listed here).

# ExifTool / Exiv2 file metadata (optional subprocesses)
# EXIFTOOL_BIN=exiftool
# EXIFTOOL_TIMEOUT_SECONDS=120
# EXIV2_BIN=exiv2
# EXIV2_TIMEOUT_SECONDS=120
# METADATA_ENGINE=exiftool   # exiftool | exiv2 | auto  (auto: try Exiv2, then ExifTool)
# METADATA_MAX_UPLOAD_BYTES=52428800  # ~50 MiB

# OSINTMap — curated regional link catalog (https://github.com/cipher387/osintmap)
# OSINTMAP_README_URL=https://raw.githubusercontent.com/cipher387/osintmap/main/README.md

# ── LLM (Claude Agent SDK + report synthesis) ───────────────
# Required for TS Anthropic orchestrator and for Python Reporter LLM narratives.
# Leave empty to run /api/v1/scan with deterministic report only (placeholders for section/exec summaries).
ANTHROPIC_API_KEY=

# ── OpenRouter (optional alternative orchestrator backend) ──
# Set ORCHESTRATOR_BACKEND=openrouter in orchestration to use this path (see orchestration/src/queue/jobs.ts).
OPENROUTER_API_KEY=
# Optional attribution for OpenRouter rankings / dashboard (https://openrouter.ai/docs)
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Grond
# Model id via OpenRouter, e.g. openrouter/auto or anthropic/claude-3.5-sonnet
OPENROUTER_MODEL=openrouter/auto
# Scales LangGraph recursionLimit when OPENROUTER_RECURSION_LIMIT is unset (Deep Agents path)
OPENROUTER_MAX_STEPS=16
# Optional: override LangGraph recursionLimit (graph steps, not only LLM turns)
# OPENROUTER_RECURSION_LIMIT=80
# orchestration only: anthropic (default) | openrouter
ORCHESTRATOR_BACKEND=anthropic

# ── PostgreSQL (primary storage + pgvector) ─────────────────
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/grond

# ── Redis (BullMQ job queue) ─────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Neo4j (entity relationship graph) ───────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# ── Vector Store ─────────────────────────────────────────────
# Choose one backend: "pgvector" (default) or "qdrant"
EMBEDDING_BACKEND=pgvector
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Required only if EMBEDDING_BACKEND=qdrant:
QDRANT_URL=http://localhost:6333

# ── S3-Compatible Artifact Store ─────────────────────────────
# For MinIO (self-hosted):
S3_ENDPOINT=http://localhost:9000
# For Cloudflare R2: S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# For AWS S3: leave S3_ENDPOINT blank
S3_BUCKET=grond-artifacts
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# ── OpenSearch / Elasticsearch (full-text search) ────────────
OPENSEARCH_URL=http://localhost:9200

# ── Observability ────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=info
ENVIRONMENT=development

# ── Active scan (Nmap) — synchronous POST /api/v1/scan ───────
#
# Authorization model (see docs/security-authorization.md):
# - End-user input (target in the UI or API body) only states *what* to scan — it is not permission.
# - Permission must come from a separate process (contract/SOW, internal ticket, manager approval, etc.)
#   and be represented as a server-side record checked before Nmap runs.
#
# In Grond today (Python):
# - nmap_tool calls require_authorization() against an AuthorizationService (src/core/authorization.py).
# - GROND_AUTHORIZED_SCAN_TARGETS (CSV below) seeds in-memory grants for tool=nmap, analyst_id=* — narrow
#   dev/staging use only. Production should move to persisted AuthorizationRecord rows (e.g. DB) after
#   your real approval workflow writes them.
# - GROND_DEV_BYPASS_NMAP_HITL only affects LangGraph HITL in development; it does not bypass
#   require_authorization or the CSV grants. It is ignored unless ENVIRONMENT=development.
#
# LangGraph may still interrupt for human approval when run_nmap=true; the bare HTTP handler cannot
# resume that interrupt — dev bypass addresses that gap locally only.
#
# GROND_DEV_BYPASS_NMAP_HITL=false
# GROND_AUTHORIZED_SCAN_TARGETS=127.0.0.1,scanme.nmap.org,*.customer.example,customer.example
#
# Optional: load grants from PostgreSQL at startup (table created automatically on first use).
# GROND_ACTIVE_SCAN_AUTH_FROM_DB=false
#
# Optional: protect POST /api/v1/admin/active-scan-authorizations (workflow automation after approval).
# If unset/empty, that route returns 503. Send header X-Grond-Authorization-Admin-Key: <same value>.
# GROND_AUTHORIZATION_ADMIN_KEY=

# ── FastAPI ──────────────────────────────────────────────────
SECRET_KEY=change-me-at-least-32-chars-long
GROND_API_URL=http://localhost:8000
# Comma-separated allowed browser origins (Next.js UI) for cross-origin scan requests.
# Loaded into the process environment only if you start uvicorn with --env-file .env (see README Quick Start).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── (Internal) Python-to-TS service URL ─────────────────────
# Set in the TS orchestration layer to point at the Python FastAPI service
# GROND_API_URL=http://localhost:8000
