{
  "name": "@grond/orchestration",
  "version": "0.1.0",
  "description": "Grond OSINT — TypeScript agent orchestration via Claude Agent SDK",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --noEmit && tsc",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "enqueue-scan": "tsx scripts/enqueue-scan.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^1.0.0",
    "@anthropic-ai/sdk": "0.95.0",
    "@langchain/openrouter": "^0.2.4",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.50.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.54.0",
    "@opentelemetry/sdk-node": "^0.54.0",
    "@sentry/node": "^8.0.0",
    "bullmq": "^5.0.0",
    "deepagents": "^1.10.0",
    "dotenv": "^16.0.0",
    "eventemitter3": "^5.0.1",
    "ioredis": "^5.3.0",
    "neo4j-driver": "^5.0.0",
    "pino": "^9.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  }
}
